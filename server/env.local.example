# 数字人服务环境变量示例 —— 复制为 env.local 后按需修改
#
#   cp env.local.example env.local
#
# env.local 已加入 .gitignore（含本机绝对路径，不该入库）。
# 加载方式：config.py 会在导入时自动读取本文件，无需手工 source；
# 因此无论用 ./start-all.sh、./ctl.sh、还是直接 python run.py 启动，行为都一致。
#
# 变量引用：支持 $SRV_DIR（自动指向 server/ 目录）与前文已定义的变量，
# 展开规则与 shell 的 source 一致。

# 配对 Token：必须与手机端「设置 → Mac 服务连接 → 配对 Token」逐字一致，
# 否则手机每次请求都是 401，而 App 只显示「上传失败」，很难定位。
export DH_TOKEN="digital-human"

# ---- ASR 兜底 / 语言守卫（whisper.cpp，**可选**，默认关闭）----
# 两条用途：
#   ① 兜底：两级主后端都加载失败时接管，管线不断。
#   ② 语言守卫：主后端结果含假名/谚文（误判成日/韩语）时，用 -l zh 重转一次。
# 未安装/未启用不影响主链路：守卫拿不到结果就保留原后端结果（属预期降级，只 WARN 一次）。
# 站外分发版默认注释掉，避免依赖 Homebrew（客户机没 brew 就跑不了）。
# 安装：brew install whisper-cpp
# export DH_WHISPER_BIN="/opt/homebrew/bin/whisper-cli"
# 模型需自行下载放到 server/models/，推荐 large-v3-turbo（中文 accuracy / 速度平衡）
# export DH_WHISPER_MODEL="$SRV_DIR/models/ggml-large-v3-turbo.bin"
# ---- 行业词表（术语纠偏）----
# 一个行业 = industries/ 下的一份 .txt（每行一词，# 开头是注释）。
# 内置三个：smart_home（智能家居/弱电）、decoration（装修/建材）、general（不偏置）。
# 加自己的行业：复制一份改名、往里写词即可，不用改任何代码。
#
# 当前行业存在 server/data/industry.txt，手机端「设置 → 行业词表」可直接切换。
# 这里**不要**设 DH_INDUSTRY —— 设了会把行业锁死，手机端就切不动了；
# 只有在多实例部署、需要运维强制指定行业时才用它。
# export DH_INDUSTRY="smart_home"

# ASR 术语引导（whisper 兜底后端的 initial prompt）。
# 只写场景描述：行业术语由 config 依当前行业自动追加，这里重复写会挤占上下文。
export DH_ASR_PROMPT="以下是中文多人对话，口语化，有重复和语气词。"

# Fun-ASR-Nano 热词：**只写真专名**（人名、项目名、自家产品名），不要写行业通用词。
# 2026-09-05 实测（60 段真实录音）：
#   无热词        8.0x 实时   术语命中 10   字数 1910
#   101 个行业词  2.9x 实时   术语命中 10   字数 2366 —— 慢 2.8 倍，命中一个没多
# 更要命的是内容退化：一段从 37 字变成 535 字（「可以了」复读 20 次）、
# 一段后半截变成「嗯嗯嗯嗯嗯」、「两千七到六千五」被写成「2000提到6000」。
# 根因：热词会写进解码上下文，把「场景/升级/面板」这种高频常用词反复示范，
# 模型于是复读它们。行业通用词的纠偏交给 LLM 提示词在文本层做，不要塞热词。
export DH_ASR_HOTWORDS=""
# 热词数量硬上限（超出截断）。默认 30 已很宽松，真专名通常不超过 10 个。
# export DH_HOTWORD_MAX=30

# ---- 声纹（3D-Speaker ERes2Net，sherpa-onnx speaker embedding）----
export DH_SPEAKER_MODEL="$SRV_DIR/models/speaker_ecapa.onnx"

# ---- 非人声检测（AudioTagging Zipformer + AudioSet 527 类）----
# 用于把「音乐 / 键盘 / 噪声 / 静默」挡在转写之外；电视里的人声仍判为人声。
export DH_AUDIO_TAGGING_MODEL="$SRV_DIR/models/audio_tagging/model.onnx"
export DH_AUDIO_TAGGING_LABELS="$SRV_DIR/models/audio_tagging/class_labels_indices.csv"
# 判定为人声的分数阈值。0.25 是初值，真实环境建议实测微调。
export DH_AUDIO_TAGGING_SPEECH_THRESHOLD=0.25

# ---- LLM 后端（去口气 + 每日总结）----
#
# 必须用 mlx-lm server，不要用 LM Studio。原因（2026-09-03 实测）：
# Qwen3.5 是思考型模型，mlx-lm 支持请求体里的 chat_template_kwargs
# {enable_thinking:false} 关闭思考；LM Studio 会忽略该参数，把全部 token 预算
# 耗在 reasoning_content 上，content 恒为空 —— 表现为「干净稿空白、总结空白」，
# 而 /v1/models 探测完全正常，日志里没有任何报错。
export DH_LLM_BASE_URL="http://127.0.0.1:1235/v1"
export DH_LLM_MODEL="qwen3.5-4b"
# mlx-lm 的 /v1/models 返回的是模型目录绝对路径，请求体 model 字段必须与之逐字一致。
# 取值方法：curl -s http://127.0.0.1:1235/v1/models
# 下面这行是占位符，务必换成你机器上的真实路径；对不上会 404，
# 表现为「干净稿与总结全空白」而日志里没有任何报错，很难定位。
export DH_LLM_SERVED_ID="/path/to/mlx/model-dir/Qwen3.5-4B-4bit"
# start-all.sh 用这个端口拉起 mlx-lm 并等待就绪
export DH_LLM_PORT=1235

# ---- 门店 Home Assistant（可选，只读）----
# 用途：/api/ha/{overview,devices,health} 设备概览；talk 注入 ha_context，
# 让管家少全量查一次 HA（门店 6000+ 实体）。
# 注意：服务端**只读**，真正的设备控制在 Hermes 执行层，不在这里重复实现，
# 避免两处逻辑漂移。未配置时 HA 相关端点返回空，不影响采集与转写主链路。
# 令牌获取：HA「用户资料 → 长期访问令牌 → 创建」。
# export DH_HA_URL="http://127.0.0.1:8123"
# export DH_HA_TOKEN=""
# export DH_HA_CACHE_TTL=60
# export DH_HA_TIMEOUT=3

# ---- 本人声纹别名（可选）----
# 让「本人」声纹锚点额外接受这些称呼（英文逗号分隔）。
# 与启动时唤醒词（talk 的别名组）语义不同：这里只影响「谁被认成本人」。
# export DH_SELF_ALIASES="大锅,老王"

# ---- 处理触发模式（三种，任选 / 组合）----
# 手机上传录音后，什么时候开始转写 + 聚类 + 去口气 + 总结：
#   ① 实时：上传即处理，吃内存（ASR + 4B 模型常驻），适合高配电脑自行权衡
#        DH_AGG_WINDOWS=          ← 留空
#        DH_AGG_BATCH_MIN=0       ← 关闭数量触发
#   ② 固定时间窗口（默认，按日程跑）
#        DH_AGG_WINDOWS=13:00,17:45
#        DH_AGG_BATCH_MIN=0
#   ③ 数量触发：积压到达阈值就自动开跑，**处理完自动停掉并释放内存**
#        DH_AGG_WINDOWS=          ← 留空
#        DH_AGG_BATCH_MIN=30      ← 10~100，默认 30
# ② 和 ③ 可同时开启（任一满足即触发，默认即是这种）；① 开启时无需再开 ② ③。
# 窗口外/未达标时：上传照常落库，只是不处理，日志会记 deferred。
# export DH_AGG_WINDOWS="13:00,17:45"
# export DH_AGG_SPAN_MIN=90
# export DH_AGG_BATCH_MIN=30

# ---- 服务绑定 ----
# export DH_HOST="0.0.0.0"
# export DH_PORT=8766
